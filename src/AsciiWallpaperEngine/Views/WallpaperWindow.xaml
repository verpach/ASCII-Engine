<Window x:Class="AsciiWallpaperEngine.Views.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        AllowsTransparency="False"
        Background="Black">
    <Grid>
        <Image x:Name="WallpaperImage" Stretch="Fill" SnapsToDevicePixels="True"/>
    </Grid>
</Window>
